# Copy to .env and fill in. Never commit .env.

# --- Telegram (MTProto user account of the AGENT) ---
# Get API_ID / API_HASH at https://my.telegram.org, section "API development tools"
TG_API_ID=1234567
TG_API_HASH=replace_me
# Session file path (without extension). Created by `python -m scripts.login`.
TG_SESSION=sessions/agent

# Who the agent talks to. Tests: your second account. Final run: vlad_dev_7
MANAGER_USERNAME=vlad_dev_7

# --- Booking goal (agent may accept ONLY these exact terms on its own) ---
BOOKING_TZ=Europe/London
BOOKING_TIME=17:00
BOOKING_PARTY_SIZE=2

# --- Operator (human-in-the-loop) ---
# saved_messages: questions go to the agent account's Saved Messages (answer from phone)
# console: questions are asked in the terminal (debug)
OPERATOR_CHANNEL=saved_messages

# --- Live behaviour ---
# Merge manager messages sent in a quick burst (seconds)
DEBOUNCE_S=4
# One polite nudge if the manager goes silent (minutes)
FOLLOWUP_AFTER_MIN=10
# Don't open a new conversation this close to the slot (minutes); --force overrides
START_GUARD_MIN=20
# Show "typing…" before each reply
TYPING_SIMULATION=true

# --- LLM ---
# Pick model ids from `python -m scripts.list_models` (what YOUR key can use).
# Providers: openai | gemini | groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
# Optional fallback used when the primary is rate-limited/down/misconfigured.
# Empty provider = no fallback. Example: LLM_FALLBACK_PROVIDER=gemini + a model id.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# Empty = provider default (OpenAI reasoning models such as gpt-5.x reject custom values)
LLM_TEMPERATURE=
LLM_TIMEOUT_S=120
# Reasoning depth (lower = faster + cheaper; a chat reply needs little).
# OpenAI: minimal | low | medium | high | empty = model default
OPENAI_REASONING_EFFORT=low
# Gemini: minimal | low | medium | high | empty = model default
GEMINI_THINKING_LEVEL=low
# https://platform.openai.com/api-keys | https://aistudio.google.com/apikey | https://console.groq.com/keys
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Voice (pip install -e ".[voice]" + ffmpeg on PATH) ---
# Voice notes from the agent. VOICE_MODE:
#   after_opening: the first message is text, every later reply is a voice note
#   mirror: voice only while the manager's latest message is a voice note
# The final booking confirmation is always sent as text.
VOICE_ENABLED=true
VOICE_MODE=after_opening
# Speech-to-text: local (faster-whisper, free) | openai (paid, cheap) | groq (free tier)
STT_PROVIDER=local
# Empty = default (local: small.en, openai: gpt-4o-mini-transcribe, groq: whisper-large-v3-turbo)
STT_MODEL=
# edge-tts British voices: en-GB-RyanNeural, en-GB-SoniaNeural, en-GB-LibbyNeural, en-GB-ThomasNeural
TTS_VOICE=en-GB-RyanNeural

# --- Runtime ---
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=INFO
